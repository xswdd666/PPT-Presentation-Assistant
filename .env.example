NODE_ENV=development
WEB_HOST=127.0.0.1
WEB_PORT=3000
DATABASE_URL=postgresql://deck:deck@localhost:5432/deck_rehearsal
OBJECT_STORAGE_BUCKET=deck-rehearsal-local
JOB_QUEUE_NAME=deck-rehearsal

# Local development model (never put a real key in this example)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
# DATA_DIR defaults to <workspace>/.local-data

# true: Web runs the integrated worker. false: run pnpm dev:worker separately.
EMBEDDED_WORKER=true
# DATA_DIR must be the same absolute directory for Web and Worker.
# DATABASE_URL / OBJECT_STORAGE_BUCKET / JOB_QUEUE_NAME above are reserved; local mode does not use them.
